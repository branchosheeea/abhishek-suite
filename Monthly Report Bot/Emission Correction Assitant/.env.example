# Copy this file to .env.local. Never commit .env.local.
#
# Diagnostic records (sessions, findings, DNV errors, notes, audit). Required.
# The same Atlas cluster as the Inspection Reports app may be used; data goes to the "emissions" database.
EMISSIONS_MONGODB_URI=

# Optional, recommended: separate database users for the original-file store (GridFS bucket "source_files"
# and collection "source_artifacts"). Without them the app uses EMISSIONS_MONGODB_URI for everything and the
# Integrity panel reports that originals are protected by the application only, not by the database.
#   Ingestion user:   insert + find on emissions.source_artifacts, source_files.files, source_files.chunks
#   Reader user:      find only on the same collections
#   Diagnostics user (EMISSIONS_MONGODB_URI): find/insert/update/createIndex on the diagnostic collections only
#   (see the Storage integrity page for the list) — not database-wide readWrite.
EMISSIONS_SOURCE_WRITE_URI=
EMISSIONS_SOURCE_READ_URI=

# Optional: database name (default "emissions")
# EMISSIONS_DB=emissions

# Optional: DNS servers (comma-separated IPs) used to resolve mongodb+srv:// connection strings, for networks
# whose resolver does not answer SRV queries. Applies to this app's process only.
EMISSIONS_DNS_SERVERS=8.8.8.8
