# Local Guarantee Claim Manager configuration. Copy values into the process environment as needed.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
GC_GRAPH_ENABLED=false
GC_GRAPH_SYNC_INTERVAL_MINUTES=5
# Optional override for the name on Guarantee Claim records; normally the person signed in to NeraVeda is used.
GC_LOCAL_USER_NAME=
GC_VESSEL_AUTO_MATCH_THRESHOLD=90
GC_VESSEL_REVIEW_THRESHOLD=80
GC_VESSEL_MATCH_MARGIN=8
